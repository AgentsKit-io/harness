{
  "baseBranch": "main",
  "workspaces": [
    "apps/docs"
  ],
  "global": [
    "package.json",
    "tsconfig.json",
    "biome.json",
    "vitest.config.ts",
    ".oxlintrc.json",
    ".github/**",
    ".husky/**",
    "ci-standard/**",
    "deploy/**",
    "e2e-kit/**",
    ".npmrc",
    ".changeset/config.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
