{
  "schemaVersion": 1,
  "project": {
    "name": "AgentsKit Harness"
  },
  "corpus": {
    "agent": {
      "root": "apps/docs/content/docs",
      "index": "apps/docs/content/docs/index.mdx",
      "include": [
        "**/*.md",
        "**/*.mdx"
      ],
      "exclude": [
        "**/node_modules/**"
      ]
    },
    "human": [
      {
        "plugin": "fumadocs",
        "options": {
          "contentDir": "apps/docs/content/docs",
          "urlPrefix": "/docs"
        }
      },
      {
        "plugin": "plain-markdown",
        "options": {
          "root": ".",
          "include": [
            "README.md"
          ],
          "urlPrefix": "/docs"
        }
      }
    ]
  },
  "routing": {
    "options": {
      "ownership": {
        "harness-site": {
          "path": "apps/docs",
          "purpose": "Public Fumadocs product site and its curated documentation.",
          "agentDoc": "docs/for-agents/packages/harness-site.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm docs:build"
          ]
        },
        "ecosystem-manifest": {
          "path": "ecosystem.json",
          "purpose": "Shared product metadata and public ecosystem references.",
          "agentDoc": "docs/for-agents/packages/ecosystem-manifest.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "node scripts/verify-ecosystem-public-outputs.mjs"
          ]
        },
        "harness-core": {
          "path": "src",
          "purpose": "The @agentskit/harness CLI, loop, verification kernel and adapters.",
          "agentDoc": "docs/for-agents/packages/harness-core.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm typecheck",
            "pnpm test"
          ]
        },
        "harness-scripts": {
          "path": "scripts",
          "purpose": "Repository generators, verifiers and node --test suites run by the CI.",
          "agentDoc": "docs/for-agents/packages/harness-scripts.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm test:docs-artifacts"
          ]
        },
        "harness-tests": {
          "path": "test",
          "purpose": "Vitest suites, fixtures and helpers for the @agentskit/harness package.",
          "agentDoc": "docs/for-agents/packages/harness-tests.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm test"
          ]
        },
        "harness-examples": {
          "path": "examples",
          "purpose": "Runnable loop configs and minimum-profile samples.",
          "agentDoc": "docs/for-agents/packages/harness-examples.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "node scripts/verify-harness-examples.mjs"
          ]
        },
        "harness-skills": {
          "path": "skills",
          "purpose": "Agent skills shipped with the harness (loop skill).",
          "agentDoc": "docs/for-agents/packages/harness-skills.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm test:loop"
          ]
        },
        "harness-experimental": {
          "path": "experimental",
          "purpose": "Experimental cycle, discovery and pilot code kept outside the stable API.",
          "agentDoc": "docs/for-agents/packages/harness-experimental.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm typecheck"
          ]
        },
        "harness-evals": {
          "path": "evals",
          "purpose": "Eval manifest used to score loop behavior.",
          "agentDoc": "docs/for-agents/packages/harness-evals.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm test:eval-battery"
          ]
        },
        "harness-benchmarks": {
          "path": "benchmarks",
          "purpose": "Recorded benchmark baselines and eval results.",
          "agentDoc": "docs/for-agents/packages/harness-benchmarks.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm test"
          ]
        },
        "harness-release": {
          "path": "release",
          "purpose": "Release manifest, notes and qualification evidence.",
          "agentDoc": "docs/for-agents/packages/harness-release.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "node scripts/verify-release-evidence.mjs"
          ]
        },
        "harness-compatibility": {
          "path": "compatibility",
          "purpose": "Compatibility manifest, report and migration/rollback notes.",
          "agentDoc": "docs/for-agents/packages/harness-compatibility.md",
          "humanDoc": "https://harness.agentskit.io/docs",
          "checks": [
            "pnpm test:compatibility"
          ]
        }
      },
      "intents": [
        {
          "id": "understand-harness",
          "title": "Understand AgentsKit Harness",
          "paths": [
            "apps/docs/content/docs/index.mdx"
          ]
        }
      ],
      "changes": [
        {
          "id": "change-harness-docs",
          "title": "Change public Harness documentation",
          "startHere": "apps/docs/content/docs/index.mdx"
        }
      ]
    }
  },
  "index": {
    "outFile": ".doc-bridge/index.json",
    "llmsTxt": {
      "enabled": true,
      "outFile": ".doc-bridge/llms.txt",
      "preamble": "AgentsKit Harness is the configurable, open-source SDLC loop for issue-to-release work. Public product documentation lives on the Fumadocs site at https://harness.agentskit.io/docs."
    }
  },
  "conformance": {
    "documentationStandardV1": {
      "rawSources": [
        "README.md",
        "apps/docs/content/docs/index.mdx"
      ],
      "contributionPaths": [
        "CONTRIBUTING.md"
      ],
      "links": [
        {
          "url": "https://www.agentskit.io",
          "paths": [
            "README.md"
          ]
        },
        {
          "url": "https://registry.agentskit.io",
          "paths": [
            "README.md"
          ]
        },
        {
          "url": "https://chat.agentskit.io",
          "paths": [
            "README.md"
          ]
        },
        {
          "url": "https://doc-bridge.agentskit.io",
          "paths": [
            "README.md"
          ]
        },
        {
          "url": "https://code-review.agentskit.io",
          "paths": [
            "README.md"
          ]
        },
        {
          "url": "https://harness.agentskit.io",
          "paths": [
            "README.md"
          ]
        }
      ],
      "ecosystemContract": {
        "manifest": "ecosystem.json",
        "claims": "ecosystem-claims.json",
        "productId": "harness"
      },
      "metadata": [
        {
          "path": "apps/docs/app/layout.tsx",
          "contains": [
            "export const metadata",
            "title:",
            "description:",
            "openGraph:"
          ]
        }
      ],
      "quickstarts": [
        {
          "id": "first-loop",
          "doc": "apps/docs/content/docs/examples/first-loop.mdx",
          "test": "test/loop-presets-init.test.ts",
          "command": "pnpm test",
          "testContains": [
            "describe('loop init'"
          ]
        }
      ],
      "visuals": [
        "apps/docs/app/icon.svg"
      ],
      "diagrams": [
        {
          "path": "docs/PRD-0.4.0.md",
          "contains": [
            "```mermaid"
          ]
        }
      ],
      "exceptions": []
    }
  },
  "gates": {
    "preset": "standard",
    "include": [
      "documentation-standard-v1"
    ]
  },
  "surfaces": {
    "cli": {
      "bin": "ak-docs",
      "defaultFormat": "text"
    },
    "mcp": {
      "enabled": true,
      "transport": "stdio"
    }
  }
}
